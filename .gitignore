/None/

# Background research collection (literature notes + downloaded PDFs).
# Local reference material only — third-party PDFs are not redistributed here.
background_research/

# Local agent session notes (same class of tool state as .zcode/, .mimosa/).
.workbuddy/

# ZCode's ignore config (tool state, like .zcode/): synced from this
# .gitignore + ZCode defaults; kept local, never committed.
.zcodeignore
